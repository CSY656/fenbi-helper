<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>粉笔刷题助手 - 系统与模型配置</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }
        body {
            background: #f0f2f5;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            color: #333;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        .container {
            width: 100%;
            max-width: 640px;
            background: #ffffff;
            border-radius: 12px;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
            overflow: hidden;
        }
        .header {
            background: linear-gradient(135deg, #1890ff, #096dd9);
            color: #fff;
            padding: 24px 32px;
            text-align: center;
        }
        .header h1 {
            font-size: 22px;
            font-weight: 600;
            margin-bottom: 6px;
        }
        .header p {
            font-size: 13px;
            opacity: 0.88;
        }
        .content {
            padding: 24px 32px 32px;
        }
        .status-box {
            background: #e6f7ff;
            border: 1px solid #91d5ff;
            border-radius: 8px;
            padding: 12px 18px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .status-box.inactive {
            background: #fff7e6;
            border-color: #ffd591;
        }
        .status-text {
            font-size: 14px;
            color: #0050b3;
        }
        .status-box.inactive .status-text {
            color: #d46b08;
        }
        .status-actions a, .status-actions button {
            display: inline-block;
            padding: 5px 12px;
            border-radius: 4px;
            font-size: 13px;
            text-decoration: none;
            cursor: pointer;
            border: none;
            margin-left: 8px;
        }
        .btn-enter {
            background: #1890ff;
            color: #fff;
        }
        .btn-logout {
            background: #ff4d4f;
            color: #fff;
        }
        .tabs {
            display: flex;
            border-bottom: 2px solid #f0f0f0;
            margin-bottom: 20px;
        }
        .tab-btn {
            flex: 1;
            padding: 11px;
            text-align: center;
            font-size: 14px;
            font-weight: 500;
            background: none;
            border: none;
            color: #666;
            cursor: pointer;
            position: relative;
            transition: all 0.2s;
        }
        .tab-btn.active {
            color: #1890ff;
            font-weight: 600;
        }
        .tab-btn.active::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 0;
            width: 100%;
            height: 2px;
            background: #1890ff;
        }
        .form-group {
            margin-bottom: 16px;
        }
        .form-label {
            display: block;
            font-size: 13px;
            font-weight: 500;
            margin-bottom: 6px;
            color: #262626;
        }
        .form-textarea {
            width: 100%;
            height: 110px;
            padding: 10px 12px;
            font-size: 13px;
            border: 1px solid #d9d9d9;
            border-radius: 6px;
            outline: none;
            resize: vertical;
            font-family: monospace;
            transition: border-color 0.2s;
        }
        .form-textarea:focus {
            border-color: #40a9ff;
            box-shadow: 0 0 0 2px rgba(24, 144, 255, 0.2);
        }
        .form-input {
            width: 100%;
            height: 38px;
            padding: 4px 12px;
            font-size: 14px;
            border: 1px solid #d9d9d9;
            border-radius: 6px;
            outline: none;
            transition: border-color 0.2s;
        }
        .form-input:focus {
            border-color: #40a9ff;
            box-shadow: 0 0 0 2px rgba(24, 144, 255, 0.2);
        }
        .btn-submit {
            width: 100%;
            height: 40px;
            background: #1890ff;
            color: #fff;
            font-size: 14px;
            font-weight: 500;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            transition: background 0.2s;
            margin-top: 6px;
        }
        .btn-submit:hover {
            background: #40a9ff;
        }
        .btn-submit:disabled {
            background: #bfbfbf;
            cursor: not-allowed;
        }
        .guide-card {
            background: #fafafa;
            border: 1px dashed #d9d9d9;
            border-radius: 8px;
            padding: 12px 16px;
            margin-top: 18px;
            font-size: 13px;
            color: #595959;
            line-height: 1.6;
        }
        .guide-card h4 {
            color: #262626;
            margin-bottom: 6px;
            font-size: 13px;
        }
        .guide-card ol {
            padding-left: 20px;
        }
        .guide-card li {
            margin-bottom: 4px;
        }
        .alert-msg {
            padding: 10px 14px;
            border-radius: 6px;
            font-size: 13px;
            margin-top: 14px;
            display: none;
        }
        .alert-error {
            background: #fff1f0;
            border: 1px solid #ffa39e;
            color: #cf1322;
        }
        .alert-success {
            background: #f6ffed;
            border: 1px solid #b7eb8f;
            color: #389e0d;
        }
    </style>
</head>
<body>

<div class="container">
    <div class="header">
        <h1>粉笔刷题助手 - 配置中心</h1>
        <p>题库凭据管理与自定义申论大模型批改配置</p>
    </div>

    <div class="content">
        <% if (hasCookie) { %>
            <div class="status-box">
                <div class="status-text">
                    <strong>题库已连接</strong>
                    <% if (userInfo && userInfo.nick) { %>
                        (当前账号: <%= userInfo.nick %>)
                    <% } else { %>
                        (凭据已保存)
                    <% } %>
                </div>
                <div class="status-actions">
                    <a href="/practice/xingce" class="btn-enter">行测刷题</a>
                    <a href="/practice/essay" class="btn-enter" style="background: #52c41a;">申论研习</a>
                    <button type="button" class="btn-logout" onclick="logout()">退出</button>
                </div>
            </div>
        <% } else { %>
            <div class="status-box inactive">
                <div class="status-text">
                    未检测到粉笔登录态，建议先导入 Cookie 启用全量题库
                </div>
            </div>
        <% } %>

        <div class="tabs">
            <button class="tab-btn active" id="tab-cookie-btn" onclick="switchTab('cookie')">粉笔 Cookie 凭据</button>
            <button class="tab-btn" id="tab-ai-btn" onclick="switchTab('ai')">申论 AI 批改模型</button>
            <button class="tab-btn" id="tab-pwd-btn" onclick="switchTab('pwd')">账号密码登录</button>
        </div>

        <!-- 方式一：Cookie 导入 -->
        <div id="tab-cookie-content">
            <div class="form-group">
                <label class="form-label" for="cookieInput">请粘贴粉笔网 Cookie：</label>
                <textarea id="cookieInput" class="form-textarea" placeholder="例如：userid=12345678; fenbi_jwt=eyJhbGci...; sid=xxx"></textarea>
            </div>
            <button id="importBtn" type="button" class="btn-submit" onclick="importCookie()">保存并验证 Cookie</button>

            <div class="guide-card">
                <h4>如何获取粉笔 Cookie？</h4>
                <ol>
                    <li>在浏览器打开并登录粉笔网：<a href="https://tiku.fenbi.com" target="_blank" style="color: #1890ff;">tiku.fenbi.com</a></li>
                    <li>按键盘 <code>F12</code> 打开开发者工具，切换到 <strong>Network (网络)</strong> 选项卡</li>
                    <li>按 <code>F5</code> 刷新页面，在网络请求列表中点击任一请求（例如 <code>category-exercises</code>）</li>
                    <li>在右侧「Headers」的「Request Headers」中找到 <code>Cookie:</code></li>
                    <li>复制 <code>Cookie:</code> 后面整串文本粘贴到上方即可。</li>
                </ol>
            </div>
        </div>

        <!-- 方式二：申论 AI 大模型配置 -->
        <div id="tab-ai-content" style="display: none;">
            <div class="form-group">
                <label class="form-label">推荐预设服务商：</label>
                <select id="aiPresetSelect" class="form-input" onchange="applyAIPreset()" style="height: 36px; padding: 4px 8px;">
                    <option value="deepseek">DeepSeek 官方 API (推荐)</option>
                    <option value="qwen">通义千问 (DashScope / OpenAI 兼容)</option>
                    <option value="openai">OpenAI 官方</option>
                    <option value="ollama">本地 Ollama (本地开源模型)</option>
                    <option value="custom">自定义兼容 OpenAI 的接口</option>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label" for="aiBaseURL">API Base URL：</label>
                <input class="form-input" id="aiBaseURL" type="text" placeholder="https://api.deepseek.com">
            </div>
            <div class="form-group">
                <label class="form-label" for="aiKey">API Key：</label>
                <input class="form-input" id="aiKey" type="password" placeholder="sk-xxxxxxxxxxxxxxxxxxxxxxxx">
                <div id="aiKeyHint" style="margin-top: 6px; font-size: 12px; color: #52c41a; display: none; align-items: center; justify-content: space-between;">
                    <span id="aiKeyHintText"></span>
                    <label style="color: #666; cursor: pointer;"><input type="checkbox" id="clearAiKey"> 保存时清空既有密钥</label>
                </div>
            </div>
            <div class="form-group">
                <label class="form-label" for="aiModel">模型名称 (Model)：</label>
                <input class="form-input" id="aiModel" type="text" placeholder="deepseek-chat 或 deepseek-reasoner">
            </div>

            <div style="display: flex; gap: 10px; margin-top: 10px;">
                <button type="button" class="btn-submit" id="testAiBtn" style="background: #52c41a; flex: 1;" onclick="testAI()">测试模型连通性</button>
                <button type="button" class="btn-submit" id="saveAiBtn" style="flex: 1;" onclick="saveAI()">保存模型配置</button>
            </div>
            <p style="margin-top: 12px; font-size: 12px; color: #888; line-height: 1.5;">
                * 提示：模型支持 DeepSeek-V3 / DeepSeek-R1、Qwen-Max、GPT-4o、Kimi 等任何兼容 OpenAI 格式的接口。配置后即可直接在申论答题纸中发起智能批改。
            </p>
        </div>

        <!-- 方式三：账号密码 -->
        <div id="tab-pwd-content" style="display: none;">
            <div class="form-group">
                <label class="form-label" for="phone">手机号：</label>
                <input class="form-input" id="phone" type="text" placeholder="粉笔网注册手机号">
            </div>
            <div class="form-group">
                <label class="form-label" for="password">密码：</label>
                <input class="form-input" id="password" type="password" placeholder="粉笔网登录密码">
            </div>
            <button id="loginBtn" type="button" class="btn-submit" onclick="loginByPwd()">登录</button>
            <p style="margin-top: 14px; font-size: 12px; color: #888;">
                * 提示：粉笔官方目前已启用滑块验证码，若报错请优先使用【粉笔 Cookie 凭据】直接粘贴，100% 成功。
            </p>
        </div>

        <div id="alertMsg" class="alert-msg"></div>
    </div>
</div>

<script>
    function showAlert(msg, isSuccess) {
        let el = document.getElementById('alertMsg');
        el.className = 'alert-msg ' + (isSuccess ? 'alert-success' : 'alert-error');
        el.innerText = msg;
        el.style.display = 'block';
    }

    function switchTab(type) {
        const tabs = ['cookie', 'ai', 'pwd'];
        tabs.forEach(t => {
            const btn = document.getElementById(`tab-${t}-btn`);
            const content = document.getElementById(`tab-${t}-content`);
            if (t === type) {
                btn.classList.add('active');
                content.style.display = 'block';
            } else {
                btn.classList.remove('active');
                content.style.display = 'none';
            }
        });
        if (type === 'ai') loadAIConfig();
    }

    // AI 预设切换
    function applyAIPreset() {
        const val = document.getElementById('aiPresetSelect').value;
        const urlInput = document.getElementById('aiBaseURL');
        const modelInput = document.getElementById('aiModel');

        if (val === 'deepseek') {
            urlInput.value = 'https://api.deepseek.com';
            modelInput.value = 'deepseek-chat';
        } else if (val === 'qwen') {
            urlInput.value = 'https://dashscope.aliyuncs.com/compatible-mode/v1';
            modelInput.value = 'qwen-plus';
        } else if (val === 'openai') {
            urlInput.value = 'https://api.openai.com/v1';
            modelInput.value = 'gpt-4o-mini';
        } else if (val === 'ollama') {
            urlInput.value = 'http://localhost:11434/v1';
            modelInput.value = 'qwen2.5:7b';
        }
    }

    // 加载已有 AI 配置（脱敏，不回填明文 Key）
    async function loadAIConfig() {
        try {
            const res = await fetch('/api/ai/config');
            const data = await res.json();
            if (data.baseURL) document.getElementById('aiBaseURL').value = data.baseURL;
            if (data.model) document.getElementById('aiModel').value = data.model;
            if (data.provider) document.getElementById('aiPresetSelect').value = data.provider;
            const keyInput = document.getElementById('aiKey');
            const hint = document.getElementById('aiKeyHint');
            const hintText = document.getElementById('aiKeyHintText');
            const clearBox = document.getElementById('clearAiKey');
            keyInput.value = '';
            if (clearBox) clearBox.checked = false;
            if (data.hasApiKey) {
                keyInput.placeholder = `已保存密钥 ${data.maskedApiKey}（留空保持不变，输入新密钥则覆盖）`;
                hintText.textContent = `当前已保存密钥：${data.maskedApiKey}`;
                hint.style.display = 'flex';
            } else {
                keyInput.placeholder = 'sk-xxxxxxxxxxxxxxxxxxxxxxxx';
                hint.style.display = 'none';
            }
        } catch (e) {}
    }

    async function testAI() {
        const btn = document.getElementById('testAiBtn');
        btn.disabled = true;
        btn.innerText = '正在测通...';

        const apiKeyVal = document.getElementById('aiKey').value.trim();
        const clearAiKey = document.getElementById('clearAiKey') && document.getElementById('clearAiKey').checked;
        const config = {
            baseURL: document.getElementById('aiBaseURL').value.trim(),
            model: document.getElementById('aiModel').value.trim(),
            clearApiKey
        };
        if (apiKeyVal) {
            config.apiKey = apiKeyVal;
        }

        try {
            const res = await fetch('/api/ai/test', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(config)
            });
            const data = await res.json();
            if (data.success) {
                showAlert(data.message + ' (模型回复正常)', true);
            } else {
                showAlert(data.message || '连接失败，请检查配置', false);
            }
        } catch (e) {
            showAlert('测试失败: ' + e.message, false);
        } finally {
            btn.disabled = false;
            btn.innerText = '测试模型连通性';
        }
    }

    async function saveAI() {
        const apiKeyVal = document.getElementById('aiKey').value.trim();
        const clearAiKey = document.getElementById('clearAiKey') && document.getElementById('clearAiKey').checked;
        const config = {
            provider: document.getElementById('aiPresetSelect').value,
            baseURL: document.getElementById('aiBaseURL').value.trim(),
            model: document.getElementById('aiModel').value.trim(),
            clearApiKey
        };
        if (apiKeyVal) {
            config.apiKey = apiKeyVal;
        }

        try {
            const res = await fetch('/api/ai/config', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(config)
            });
            const data = await res.json();
            if (data.code === 200) {
                showAlert('模型配置已成功保存！随时可在申论刷题中发起批改。', true);
                loadAIConfig();
            } else {
                showAlert(data.message || '保存失败', false);
            }
        } catch (e) {
            showAlert('保存出错: ' + e.message, false);
        }
    }

    async function importCookie() {
        let cookie = document.getElementById('cookieInput').value.trim();
        if (!cookie) {
            showAlert('请先粘贴粉笔 Cookie 字符串', false);
            return;
        }

        let btn = document.getElementById('importBtn');
        btn.disabled = true;
        btn.innerText = '正在验证 Cookie...';

        try {
            let res = await fetch('/api/import-cookie', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ cookie })
            });
            let data = await res.json();
            if (data.code === 200) {
                showAlert('验证成功！正在跳转...', true);
                setTimeout(() => {
                    let redirectPath = new URLSearchParams(window.location.search).get('redirectPath') || data.redirectPath || '/history-category-complex';
                    window.location.href = redirectPath;
                }, 800);
            } else {
                showAlert(data.message || 'Cookie 校验失败，请检查', false);
            }
        } catch (e) {
            showAlert('请求失败: ' + e.message, false);
        } finally {
            btn.disabled = false;
            btn.innerText = '保存并验证 Cookie';
        }
    }

    async function loginByPwd() {
        let phone = document.getElementById('phone').value.trim();
        let password = document.getElementById('password').value;

        if (!phone || !password) {
            showAlert('请输入手机号和密码', false);
            return;
        }

        let btn = document.getElementById('loginBtn');
        btn.disabled = true;
        btn.innerText = '正在登录...';

        try {
            let res = await fetch('/api/login', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ phone, password })
            });
            let data = await res.json();
            if (data.code === 200) {
                showAlert('登录成功！正在跳转...', true);
                setTimeout(() => {
                    let redirectPath = new URLSearchParams(window.location.search).get('redirectPath') || data.redirectPath || '/history-category-complex';
                    window.location.href = redirectPath;
                }, 800);
            } else {
                showAlert(data.message || '登录失败，推荐使用方式一导入 Cookie', false);
            }
        } catch (e) {
            showAlert('登录请求出错: ' + e.message, false);
        } finally {
            btn.disabled = false;
            btn.innerText = '登录';
        }
    }

    async function logout() {
        if (!confirm('确定要退出当前账号并清除 Cookie 吗？')) return;
        try {
            await fetch('/api/logout', { method: 'POST' });
            window.location.href = '/setup';
        } catch (e) {
            window.location.reload();
        }
    }

    // 默认如果 URL query 带 #ai 直接打开 ai 配置
    if (window.location.hash === '#ai') {
        switchTab('ai');
    }
</script>

</body>
</html>
